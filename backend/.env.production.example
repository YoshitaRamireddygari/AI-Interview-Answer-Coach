# ==============================================================================
# PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE (BACKEND)
# ==============================================================================

# Application Environment Name (production / staging)
ENVIRONMENT=production

# Server Port (automatically assigned by PaaS such as Render, Railway, or Fly.io)
PORT=8000

# Project Metadata Title
PROJECT_NAME="AI Interview Answer Coach"

# Gemini API Key (Obtain from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=AIzaSy_YOUR_ACTUAL_PRODUCTION_KEY_HERE

# AI Provider and Gemini Model Selection
AI_PROVIDER=gemini
GEMINI_MODEL=gemini-3.8-flash

# SQLite Database File Path (For single-instance PaaS with persistent volume)
DATABASE_URL=sqlite:///./interview_coach.db

# Production CORS Allowed Origins (Comma-separated list of trusted frontend URLs)
CORS_ORIGINS=https://your-app.vercel.app,https://your-app.netlify.app
